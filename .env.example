# Hot Bags inbound endpoint (either /api/gateway/inbound or /api/integrations/whatsapp/inbound)
HOTBAGS_INGEST_URL=https://your-hotbags.vercel.app/api/integrations/whatsapp/inbound

# Auth - align names with Hot Bags (use HOTBAGS_BEARER_TOKEN in both repos)
HOTBAGS_BEARER_TOKEN=
# HMAC required for production. Set HOTBAGS_HMAC_DISABLED=true only for temporary Bearer-only mode.
HOTBAGS_HMAC_SECRET=
# HOTBAGS_HMAC_DISABLED=true  # temporary: Bearer-only; logs warning on startup

# Queue DB path (must be under DATA_DIR for correct ownership)
QUEUE_DB_PATH=/var/lib/clawdbot/queue.db

# Base for WhatsApp session + media
DATA_DIR=/var/lib/clawdbot

# Unique instance identifier for multi-bot
GATEWAY_INSTANCE_ID=clawdbot-1

# Comma-separated list of phone numbers the bot will respond to (others and group chats are ignored)
ALLOWED_PHONE_NUMBERS=+447584662710,+447887409934,+447748630646,+447557790428
# Optional: LIDs when getContactLidAndPhone fails (add from debug logs, e.g. 103160920166626)
ALLOWED_LIDS=103160920166626

# Optional: system Chromium path (if bundled Puppeteer Chromium fails on minimal VM)
# Supported in src/whatsapp/client.ts
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
